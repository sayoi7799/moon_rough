name = "sayoi7799/moon_rough"

version = "0.2.1"

readme = "README.md"

repository = "https://github.com/sayoi7799/moon_rough"

license = "MIT"

keywords = [ "rough", "sketch", "hand-drawn", "svg", "roughjs" ]

description = "A MoonBit port of rough.js 4.6.6: hand-drawn, sketchy shapes rendered to backend-agnostic op sets and SVG."

source = "src"

// Derived trait methods (Eq, Debug) are promoted to methods on purpose.

warnings = "-implicit_impl_as_method"
